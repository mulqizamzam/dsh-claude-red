{
  "name": "dsh-claude-red",
  "version": "0.2.1-rc.2",
  "description": "A curated, defensive security-engineering skill bundle for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/",
    "README.md",
    "COMPATIBILITY.md",
    "PORTING.md",
    "SECURITY.md",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/",
    "tests/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "security-engineering",
    "code-review",
    "vulnerability-triage"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node tests/smoke-provider.mjs",
    "validate": "python3 scripts/validate_package.py",
    "check": "npm test && npm run validate"
  }
}
